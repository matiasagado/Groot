# Groot environment configuration.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Ollama endpoint on the homelab XPS, reached over Tailscale.
# The /api/generate path is the streaming completion endpoint.
OLLAMA_API_URL=http://<xps-tailscale-ip>:11434/api/generate

# Analysis model. Must be pulled on the homelab Ollama instance first.
OLLAMA_MODEL_NAME=qwen2.5-coder:7b
